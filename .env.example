# =============================================================================
# Copie para .env  (cp .env.example .env)  e ajuste o que precisar.
# Estes valores são APENAS para desenvolvimento local. Nenhum segredo real.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_ENV=local
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
# Prazo TOTAL do shutdown (fx.StopTimeout). Precisa cobrir TODOS os encerramentos
# que rodam dentro dele, em sequência (o Fx executa os hooks de parada na ordem
# inversa do registro):
#   1. servidor HTTP        — HTTP_SHUTDOWN_TIMEOUT (20s), drena as requisições;
#   2. consumidor de SQS    — SQS_SHUTDOWN_GRACE (15s), se ligado;
#   3. laços da Fase 9      — WORKERS_SHUTDOWN_GRACE (10s), se ligados.
# Pior caso com os defaults: 20 + 15 + 10 = 45s. Com 25s a aplicação NÃO SUBIA
# quando o consumidor estava ligado (defeito 33 da Fase 8; a Fase 9 acrescentou a
# terceira parcela e o default subiu para 50s).
HTTP_STOP_TIMEOUT=50s
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576

# --- PostgreSQL --------------------------------------------------------------
# Host: use "postgres" dentro do Docker e "localhost" rodando a app na máquina.
DATABASE_URL=postgres://jungleg:jungleg@localhost:5432/jungleg?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s
DB_LOCK_TIMEOUT=5s
# Aplicar migrations no boot fica DESLIGADO: com várias instâncias subindo juntas,
# todas tentariam migrar ao mesmo tempo. Quem migra é o job `migrate` do compose.
DB_MIGRATIONS_ON_START=false

# --- OIDC / Keycloak ---------------------------------------------------------
# OIDC_ISSUER é o valor exato do claim "iss" do token (o que o navegador/curl
# alcança). OIDC_DISCOVERY_URL é o endereço de onde o serviço busca o
# .well-known, que pode ser o hostname interno da rede Docker.
OIDC_ISSUER=http://localhost:8080/realms/jungleg
OIDC_DISCOVERY_URL=http://localhost:8080/realms/jungleg
# Endereço das CHAVES PÚBLICAS (JWKS). Vazio = usa o `jwks_uri` do discovery.
# Só é preciso preencher quando o IdP anuncia um endereço que o serviço não
# alcança — o caso clássico é o Keycloak em container, que anuncia
# `http://localhost:8080/...` e, de dentro do container, `localhost` é o próprio
# container (o discovery passa, o readiness fica UP e todo token vira 503).
# Exemplo dentro do Docker Compose:
#   OIDC_JWKS_URL=http://host.docker.internal:8080/realms/jungleg/protocol/openid-connect/certs
OIDC_JWKS_URL=
# Audience exigida no claim "aud" (o realm publica "jungleg-api" nos três clients).
OIDC_AUDIENCE=jungleg-api
# Por quanto tempo as chaves públicas ficam em cache. Rotação de chave é
# acompanhada antes disso: `kid` desconhecido dispara rebusca do JWKS.
OIDC_JWKS_CACHE_TTL=15m
# Tolerância de relógio ao validar exp/nbf (o relógio do IdP e o do serviço não
# são o mesmo).
OIDC_CLOCK_SKEW=30s
# Prazo de CADA chamada ao IdP (discovery e JWKS). É separado do
# HTTP_REQUEST_TIMEOUT: ali o prazo é da requisição do cliente, aqui é da
# dependência.
OIDC_HTTP_TIMEOUT=5s
# Endpoint de token do IdP. NÃO é usado pela aplicação (o serviço nunca emite
# token — README §2); existe para ferramentas e para os testes de integração
# obterem token por client_credentials.
OIDC_TOKEN_URL=http://localhost:8080/realms/jungleg/protocol/openid-connect/token

# --- SQS / LocalStack --------------------------------------------------------
# Host: use "localstack" dentro do Docker e "localhost" rodando a app na máquina.
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
# Credenciais do broker. Os nomes são SQS_* porque a aplicação monta as
# credenciais estáticas a partir da própria configuração (`SQSConfig`); os nomes
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY do SDK NÃO são lidos por ela.
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_EVENTS_DLQ=wallet-events-dlq.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT=30s
SQS_WAIT_TIME=20s
SQS_BATCH_SIZE=10
SQS_CONSUMER_CONCURRENCY=8
# Retry do consumidor por ChangeMessageVisibility (a mensagem não é removida nem
# descartada: fica invisível pelo prazo e volta).
SQS_BASE_BACKOFF=2s
SQS_MAX_BACKOFF=1m
# Prazo para concluir o lote em andamento no encerramento antes de liberar a
# visibilidade do que sobrou (reentrega segura). Cabe dentro do HTTP_STOP_TIMEOUT.
SQS_SHUTDOWN_GRACE=15s
SQS_CONSUME_TRANSACTIONS=false

# --- Outbox (publicador de eventos) -----------------------------------------
# Ligue quando esta instância deve publicar os eventos pendentes da outbox em
# SQS_EVENTS_QUEUE (wallet-events.fifo). Várias instâncias podem publicar ao
# mesmo tempo: a disputa é resolvida no banco (FOR UPDATE SKIP LOCKED + lease).
OUTBOX_ENABLED=false
OUTBOX_BATCH_SIZE=50
# Por quanto tempo o lote reivindicado fica fora do alcance das outras
# instâncias. Se o processo morrer no meio, o evento volta sozinho quando o
# lease vencer (recuperação de trabalho abandonado).
OUTBOX_LEASE=30s
OUTBOX_POLL_INTERVAL=1s
# Teto de tentativas de publicação: esgotado, o evento vai para a QUARENTENA (não
# é apagado nem marcado como publicado; o atraso da outbox denuncia que ele
# existe).
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF=2s
OUTBOX_MAX_BACKOFF=5m
# Prazo da quarentena: quanto tempo o evento emparedado fica fora da fila de
# trabalho. Continua pendente e visível em métrica/log; um operador pode
# desquarentená-lo mexendo em available_at. Precisa ser >= OUTBOX_MAX_BACKOFF.
OUTBOX_PARKED_BACKOFF=1h

# --- Worker de referências (PENDING_REFERENCE) -------------------------------
# Retoma as operações que esperam uma referência que ainda não chegou. A
# tentativa e o próximo instante estão PERSISTIDOS na transação, então reiniciar
# a aplicação não perde a pendência.
REFERENCE_ENABLED=false
REFERENCE_POLL_INTERVAL=2s
REFERENCE_BATCH_SIZE=25
# TTL: esgotado (tentativas OU idade), a operação vira REJECTED com
# failureCode REFERENCE_NOT_FOUND e produz o evento de rejeição (README §7).
REFERENCE_MAX_ATTEMPTS=20
REFERENCE_BASE_BACKOFF=5s
REFERENCE_MAX_BACKOFF=10m
# Reaper: retoma transações presas em PENDING (segurança extra do README §6.3 —
# a operação que ficou no meio de um crash).
REFERENCE_REAPER_INTERVAL=1m
REFERENCE_PENDING_MAX_AGE=2m

# --- Laços de trabalho (runner) ----------------------------------------------
# Prazo para os laços em andamento terminarem depois do SIGTERM. É UM prazo para o
# CONJUNTO (os laços param em paralelo), e não um por laço — é o que mantém a soma
# do HTTP_STOP_TIMEOUT em 20 + 15 + 10 no pior caso.
# O que não der tempo volta sozinho pelo lease (available_at da outbox e
# next_resolution_attempt_at da transação): nada é perdido.
WORKERS_SHUTDOWN_GRACE=10s

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=info

# --- Só para a imagem do Dockerfile (não usados pela aplicação) --------------
POSTGRES_USER=jungleg
POSTGRES_PASSWORD=jungleg
POSTGRES_DB=jungleg
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
