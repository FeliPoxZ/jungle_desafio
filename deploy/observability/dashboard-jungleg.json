{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operações por desfecho (rate 5m)",
      "description": "jungleg_wager_operations_total conta cada ATENDIMENTO (HTTP e SQS), por tipo (kind) e desfecho (status). Replay também conta aqui; ele é destacado no painel de idempotência.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (status) (rate(jungleg_wager_operations_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Operações por tipo",
      "description": "BET, WIN, LOSS, REFUND, ROLLBACK. LOSS aparece como PROCESSED e não movimenta saldo — é o esperado.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(jungleg_wager_operations_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência de processamento — p50 / p95 / p99",
      "description": "histogram_quantile sobre jungleg_wager_operation_duration_seconds_bucket. Inclui o caminho HTTP e o SQS. Sob concorrência na MESMA carteira o p99 cresce porque o lock de linha serializa as operações daquela carteira (medido: 579 ms contra 166 ms em carteiras distintas).",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(jungleg_wager_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(jungleg_wager_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(jungleg_wager_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Atraso da outbox",
      "description": "Idade do evento pendente mais antigo. Acima de um lease (30 s) significa que a publicação está parada ou o SQS está fora. O publicador também loga outbox_atrasada (WARN) nesse caso.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "jungleg_wager_outbox_pending_age_seconds",
          "legendFormat": "pendente mais antigo"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Publicação da outbox por resultado",
      "description": "success = saiu e foi marcado; retry = falhou e vai voltar com backoff; failed = recusa permanente ou tentativas esgotadas (quarentena).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (result) (rate(jungleg_wager_outbox_publish_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retentativas por etapa",
      "description": "Cada linha é quem repetiu: sqs_receive/sqs_consume/sqs_publish (consumo), outbox_claim/outbox_mark, reference_claim, reaper_scan, worker_<laço> (runner).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (stage) (rate(jungleg_wager_retries_total[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Mensagens na DLQ (total)",
      "description": "jungleg_wager_dlq_messages_total. Qualquer valor > 0 é trabalho humano: a mensagem foi recusada como permanente.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(jungleg_wager_dlq_messages_total[$__range]))",
          "legendFormat": "DLQ"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Replays idempotentes (janela)",
      "description": "jungleg_wager_idempotent_replays_total: reenvios atendidos com o resultado persistido. É tráfego esperado, não erro.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(jungleg_wager_idempotent_replays_total[$__range]))",
          "legendFormat": "replays"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Reentregas reconhecidas pela inbox",
      "description": "jungleg_wager_inbox_duplicates_total: a mesma mensagem chegou de novo e foi recusada pela inbox. Mostra a reentrega que o broker fez.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(jungleg_wager_inbox_duplicates_total[$__range]))",
          "legendFormat": "reentregas"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Conflitos de transação",
      "description": "jungleg_wager_transaction_conflicts_total: transações repetidas por conflito de concorrência (unicidade, lock) ou falha transitória. Uma taxa alta indica disputa na MESMA carteira.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(jungleg_wager_transaction_conflicts_total[$__range]))",
          "legendFormat": "conflitos"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tentativas até publicar um evento",
      "description": "jungleg_wager_outbox_publish_attempts: distribuição do número de tentativas por evento publicado. A maioria tem de cair no bucket 1.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (le) (rate(jungleg_wager_outbox_publish_attempts_bucket[$__rate_interval]))",
          "legendFormat": "tentativas <= {{le}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Divergências de reconciliação",
      "description": "jungleg_wager_reconciliation_divergences_total. Qualquer aumento é incidente financeiro: o saldo armazenado deixou de casar com a soma do ledger.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(jungleg_wager_reconciliation_divergences_total[$__rate_interval])",
          "legendFormat": "divergências"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Processo e readiness",
      "description": "up do alvo jungleg (o processo responde /metrics) e probe_success do /health/ready via blackbox (banco, IdP, SQS e workers). É este segundo que responde \"o worker está de pé?\" — /health/ready não é métrica Prometheus.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "up{job=\"jungleg\"}",
          "legendFormat": "up {{instance}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "probe_success{job=\"jungleg-ready\"}",
          "legendFormat": "ready {{instance}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["jungleg", "financeiro", "fase11"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
