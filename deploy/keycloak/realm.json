{
  "realm": "jungleg",
  "enabled": true,
  "displayName": "Jungle Desafio - Backend",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Provedor de jogos. Acessa apenas as PRÓPRIAS transações e não pode executar operações internas (abertura de carteira, leitura de carteira, reconciliação).",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "internal",
        "description": "Serviço interno confiável. Único autorizado a abrir carteiras, ler carteiras e executar reconciliação.",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clientScopes": [
    {
      "id": "6f1f4f7c-1111-4a11-9a11-000000000001",
      "name": "jungleg-api",
      "description": "Adiciona a audience jungleg-api ao token, exigida pela API (OIDC_AUDIENCE).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "id": "6f1f4f7c-1111-4a11-9a11-000000000011",
          "name": "audience-jungleg-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "jungleg-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic",
    "jungleg-api"
  ],
  "defaultOptionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ],
  "clients": [
    {
      "clientId": "provider-service",
      "name": "Provedor A (provider-a)",
      "description": "Client de teste que representa o provedor 'provider-a'. O claim provider_id é fixo neste client, então um token deste client NUNCA pode operar transações de outro provedor.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["jungleg-api"],
      "protocolMappers": [
        {
          "id": "6f1f4f7c-1111-4a11-9a11-000000000101",
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "id": "6f1f4f7c-1111-4a11-9a11-000000000102",
          "name": "roles-do-service-account",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "provider-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-b-service",
      "name": "Provedor B (provider-b)",
      "description": "Segundo provedor, usado nos testes de ISOLAMENTO: o token de provider-b deve receber 403 ao tentar ler ou operar transações de provider-a.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-b-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["jungleg-api"],
      "protocolMappers": [
        {
          "id": "6f1f4f7c-1111-4a11-9a11-000000000201",
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "id": "6f1f4f7c-1111-4a11-9a11-000000000202",
          "name": "roles-do-service-account",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "provider-b-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "internal-service",
      "name": "Serviço interno",
      "description": "Role 'internal'. Único autorizado a abrir carteira (POST /wallets), ler carteira, listar ledger, reconciliar e consumir/validar operações internas. Representa a comunicação serviço-a-serviço.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "internal-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["jungleg-api"],
      "protocolMappers": [
        {
          "id": "6f1f4f7c-1111-4a11-9a11-000000000301",
          "name": "roles-do-service-account",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "internal-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "jungleg-api",
      "name": "Audience da API (não é um client utilizável)",
      "description": "Existe apenas como AUDIENCE dos tokens: a API valida OIDC_AUDIENCE=jungleg-api. Nenhum fluxo OAuth é permitido aqui — serve para impedir que um token emitido para outro público seja aceito.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
      "username": "service-account-provider-service",
      "enabled": true,
      "serviceAccountClientId": "provider-service",
      "realmRoles": ["provider"],
      "clientRoles": {
        "provider-service": ["provider"]
      }
    },
    {
      "username": "service-account-provider-b-service",
      "enabled": true,
      "serviceAccountClientId": "provider-b-service",
      "realmRoles": ["provider"],
      "clientRoles": {
        "provider-b-service": ["provider"]
      }
    },
    {
      "username": "service-account-internal-service",
      "enabled": true,
      "serviceAccountClientId": "internal-service",
      "realmRoles": ["internal"],
      "clientRoles": {
        "internal-service": ["internal"]
      }
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@jungleg.local",
      "firstName": "Operador",
      "lastName": "Interno",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": ["internal"]
    }
  ]
}
